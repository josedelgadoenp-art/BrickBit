# Copia este archivo a  .env  y rellena los valores.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).

# --- Claves de proveedor (viven SOLO aquí, en el servidor) ---
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: voz natural centralizada
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Modelo y comportamiento ---
MODEL=claude-opus-4-8
MAX_TOKENS=1024

# --- Usuarios autorizados ---
# Opción rápida (para la demo): lista "token:nombre" separada por comas.
# En producción usa USERS_FILE (abajo) o, mejor, SSO corporativo (ver README).
USERS=DEMO-TOKEN-CAMBIA-ESTO:Demo GNP
# USERS_FILE=./users.json

# --- Red y límites ---
PORT=8080
RATE_PER_MIN=20
# Orígenes web extra permitidos (además de las extensiones de Chrome), separados por comas.
# ALLOWED_ORIGINS=https://asistente.gnp.example

# --- Registro de uso (solo metadatos: usuario, tokens, ok/error) ---
# Vacío = por consola. Ruta = archivo JSONL.
LOG_FILE=./uso.jsonl
